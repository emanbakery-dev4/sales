# ─────────────────────────────────────────────────────────────
# Supabase — Project Settings → API Keys
# Use the new key format (legacy anon/service_role deprecate end of 2026)
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=          # sb_publishable_...  (safe for client bundle)
SUPABASE_SECRET_KEY=               # sb_secret_...       (server-only, never ship to client)
NEXT_PUBLIC_SUPABASE_URL=          # same as SUPABASE_URL, exposed to the client
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # same as SUPABASE_PUBLISHABLE_KEY, exposed to the client

# Legacy fallback — only needed if a dependency still expects these names
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Project Settings → Database → Connection string
DATABASE_URL=

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
JWT_SECRET=                        # generate: openssl rand -base64 32
NEXT_PUBLIC_API_URL=

# ─────────────────────────────────────────────────────────────
# Monitoring & Ops
# ─────────────────────────────────────────────────────────────
SENTRY_DSN=                        # frontend project → Settings → Client Keys (DSN)
SENTRY_DSN_WORKER=                 # worker project → Settings → Client Keys (DSN)
SENTRY_AUTH_TOKEN=                 # org Settings → Auth Tokens (for CI source-map upload)
SLACK_WEBHOOK_URL=                 # api.slack.com/apps → Incoming Webhooks

# ─────────────────────────────────────────────────────────────
# Deployment
# ─────────────────────────────────────────────────────────────
VERCEL_TOKEN=                      # Vercel → Account Settings → Tokens
RAILWAY_TOKEN=                     # Railway → Account Settings → Tokens

# ─────────────────────────────────────────────────────────────
# Notification channels (add when a provider is selected — not required for first deploy)
# ─────────────────────────────────────────────────────────────
WHATSAPP_API_TOKEN=
SMS_PROVIDER_API_KEY=
